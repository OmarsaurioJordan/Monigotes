[sub_resource type="GDScript" id="GDScript_m2uw1"]
script/source = "extends Panel

func _ready() -> void:
	for dt in $Data.get_children():
		$Scroll/Cont.add_child(dt.duplicate())
	$Data.queue_free()

func _on_btn_salir_pressed() -> void:
	queue_free()
"

[sub_resource type="GDScript" id="GDScript_3btkx"]
script/source = "extends ScrollContainer

func _ready() -> void:
	var barra := get_v_scroll_bar()
	barra.custom_minimum_size.x = 24
"

